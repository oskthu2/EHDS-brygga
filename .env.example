# Port exposed by the gateway (host)
GATEWAY_PORT=8080

# For local development without Docker — override Docker hostnames:
EHDS_TAK_URL=http://localhost:4001
EHDS_EI_URL=http://localhost:4002
EHDS_SPARR_URL=http://localhost:4003
EHDS_LOGG_URL=http://localhost:4004

# Bridge identity (HSA-id used as consumer towards NTjP/TAK)
EHDS_BRIDGE_HSA_ID=SE2321000999-EHDS

# TAK mock: override BACKEND_URL for local dev (maps mock-backend Docker hostname to localhost)
BACKEND_URL=http://localhost:4005
