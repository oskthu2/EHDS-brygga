# Port exposed by the gateway (host)
GATEWAY_PORT=8080

# Bridge (FHIR orchestration) – override Docker hostnames for local dev:
EHDS_EI_URL=http://localhost:4002
EHDS_SPARR_URL=http://localhost:4003
EHDS_LOGG_URL=http://localhost:4004

# ntjp-proxy – katalogtjänster (T1/F1) och åtkomstintygsutfärdare, override for local dev:
NTJP_TJANSTEKATALOG_URL=http://localhost:4001
NTJP_FEDKATALOG_URL=http://localhost:4006
NTJP_TOKEN_ISSUER_URL=http://localhost:4007

# Delad identitet för bryggan som konsument mot katalogtjänsterna
EHDS_BRIDGE_HSA_ID=SE2321000999-EHDS
NTJP_BRIDGE_HSA_ID=SE2321000999-EHDS

# Auth server base URL – exponeras i CapabilityStatement SMART-säkerhetsextensioner
# Sätt till extern URL i produktion, t.ex. https://auth.vardgivare.se
EHDS_AUTH_BASE_URL=http://localhost:8080

# Tjänstekatalog-mock: override BACKEND_URL for local dev
BACKEND_URL=http://localhost:4005
