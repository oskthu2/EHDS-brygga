<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>se.inera.ehds</groupId>
    <artifactId>ehds-brygga-bridge</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>fml-mapping-poc</artifactId>
  <name>EHDS Brygga – FML-utvärdering (PoC, ej en del av produktionsbryggan)</name>

  <!--
    Utvärderingsspår: kan FHIR Mapping Language (FML) konfigurera RIVTA->FHIR-mappningen
    i stället för Java-kod i mapping-engine? Se ig/input/pagecontent/fml-evaluation.md
    för resultat och slutsatser. Den befintliga Java-motorn i mapping-engine är opåverkad.
  -->

  <dependencies>
    <dependency>
      <groupId>se.inera.ehds</groupId>
      <artifactId>mapping-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- StructureMapUtilities (FML parser/engine) + en offline-kapabel IWorkerContext -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation-resources-r4</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
      <!--
        Kör den interaktiva testklienten: mvn -pl fml-mapping-poc exec:exec
        (exec:exec, inte exec:java - exec:java's isolerade klassladdare kolliderar med
        JAXB:s modul-split på JDK 17, "loader constraint violation" på DatatypeConstants/QName)
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-classpath</argument>
            <classpath/>
            <argument>se.inera.ehds.fml.FmlTestClient</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
